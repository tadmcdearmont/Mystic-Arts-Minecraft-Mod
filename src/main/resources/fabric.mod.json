{
  "schemaVersion": 1,
  "id": "mysticarts",
  "version": "${version}",
  "name": "Mystic Arts Mod",
  "description": "Remake of the classic Monk Mod for modern Minecraft 1.20.1 Fabric. Forgo armor and weapons to unlock 20 levels of spiritual martial arts through the in-game Mystic Codex book.",
  "authors": [
    "Mystic Arts Remake Team",
    "Inspired by RWTema (The Monk Mod)"
  ],
  "contact": {
    "homepage": "https://github.com/tadmcdearmont/Mystic-Arts-Minecraft-Mod"
  },
  "license": "MIT",
  "icon": "assets/mysticarts/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.mysticarts.MysticArtsMod"
    ],
    "client": [
      "net.mysticarts.client.MysticArtsClient"
    ]
  },
  "mixins": [
    "mysticarts.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
